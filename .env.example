# Supabase credentials.
#
# Copy this file to `.env` and paste your own values in. `.env` is gitignored;
# this example file is not, so never put real values here.
#
# Both come from the Supabase dashboard:  Project Settings → API
#
#   Project URL    →  EXPO_PUBLIC_SUPABASE_URL
#   anon / public  →  EXPO_PUBLIC_SUPABASE_ANON_KEY
#
# The EXPO_PUBLIC_ prefix is what makes Expo inline these into the app bundle.
# That means anyone can read them out of a shipped build — which is fine for
# these two, and is exactly why Row Level Security in supabase/schema.sql is
# what actually protects the data.
#
# NEVER add the `service_role` key here. It bypasses every policy.
#
# After editing .env, restart the bundler with a cleared cache:
#
#   npx expo start -c

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY
